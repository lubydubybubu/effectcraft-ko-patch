+    /// The Korean panel catalog is complete: exactly the reference (Chinese) catalog's source
+    /// strings, so no panel text falls back to English in a Korean interface.
+    #[test]
+    fn korean_panel_catalog_covers_every_reference_row() {
+        let hans: std::collections::BTreeSet<&str> = SIMPLIFIED_CHINESE.iter().map(|(en, _)| *en).collect();
+        let korean: std::collections::BTreeSet<&str> = KOREAN.iter().map(|(en, _)| *en).collect();
+        let missing: Vec<_> = hans.difference(&korean).collect();
+        let extra: Vec<_> = korean.difference(&hans).collect();
+        assert!(missing.is_empty(), "{} reference rows have no Korean translation: {missing:?}", missing.len());
+        assert!(extra.is_empty(), "Korean rows the reference lacks: {extra:?}");
+        assert_eq!(KOREAN.len(), SIMPLIFIED_CHINESE.len(), "a Korean source string is listed twice");
+        // A row that only copies the English source is a missed translation, except for names.
+        let hangul = |s: &str| s.chars().any(|c| ('\u{AC00}'..='\u{D7A3}').contains(&c));
+        let copies: Vec<_> = KOREAN.iter().filter(|(en, ko)| !hangul(ko) && en == ko && en.chars().filter(|c| c.is_ascii_lowercase()).count() > 3).collect();
+        assert!(copies.len() <= 20, "{} Korean rows copy the English source: {copies:?}", copies.len());
+    }
